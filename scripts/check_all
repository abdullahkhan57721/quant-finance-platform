#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> Cognitive complexity"
bash ./scripts/complexity

echo "==> Ruff lint"
python -m ruff check .

echo "==> Ruff format check"
python -m ruff format --check .

echo "==> Pyright"
python -m pyright

echo "==> Pytest"
python -m pytest
